''Patron Observer
Interface Observer{
    +update(notification: Notification)

}

Interface Subject{
    +registerObserver(o: Observer)
    +removeObserver(o: Observer)
    +notifyObservers()

}

'' Patron Iterator
interface Iterator{
    +hasNext(): boolean
    +next(): Object

}

